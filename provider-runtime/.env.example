# Generate an independent random deployment token with at least 32 characters.
PROVIDER_RUNTIME_TOKEN=
# Generate 32 random bytes, encoded as base64. Keep this key across restarts.
PROVIDER_RUNTIME_STATE_KEY=
PROVIDER_RUNTIME_HOST=127.0.0.1
PROVIDER_RUNTIME_PORT=3426
PROVIDER_RUNTIME_STATE_FILE=state/accounts.enc
